# P5/Orcarouter MTP0 only — v3 isolated vLLM 0.32.0 compatibility image (LM-head prefix fix).
# Preserves previous QSA-only candidate image, failed container and logs.
# QSA: vllm-project/vllm PR #62318; LM-head: YSLAB pinned 9492b78.
# No Python package upgrade, checkpoint edit, or source-image mutation.
ARG P5_BASE=blazux-p5-source:explicit-local-override-required
FROM ${P5_BASE}
ARG P5_BASE_IMAGE_ID
RUN test -n "${P5_BASE_IMAGE_ID}" \
 && case "${P5_BASE_IMAGE_ID}" in sha256:*) ;; *) exit 3 ;; esac
LABEL blazux.p5.state="SOURCE_CANDIDATE_NOT_QUALIFIED" \
      blazux.p5.vllm="0.32.0" \
      blazux.p5.base_image="${P5_BASE_IMAGE_ID}" \
      blazux.p5.adapter="qwen4exp-qsa62318-lmhead-v032-v3" \
      blazux.p5.lmhead="v0.32-v3" \
      blazux.p5.upstream_fix="vllm-project/vllm#62318" \
      blazux.p5.production_release="false"
ARG SP=/usr/local/lib/python3.12/dist-packages
COPY src/p5_qsa_quant_backport_v032.py /tmp/p5_qsa_quant_backport_v032.py
COPY src/p5_lm_head_quant_backport_v032_v3.py /tmp/p5_lm_head_quant_backport_v032_v3.py
RUN P5_EXPLICIT_QSA62318_IMAGE_BUILD=1 python3 /tmp/p5_qsa_quant_backport_v032.py \
      --site-packages "${SP}" --apply --json \
 && P5_EXPLICIT_LMHEAD_IMAGE_BUILD=1 python3 /tmp/p5_lm_head_quant_backport_v032_v3.py \
      --site-packages "${SP}" --apply --json \
 && rm /tmp/p5_qsa_quant_backport_v032.py /tmp/p5_lm_head_quant_backport_v032_v3.py
# Container/API lifecycle still requires Wizard's expiring exact plan approval.
